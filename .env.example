#  CivicFix — Environment Variables Template

# MongoDB connection string (Atlas or local)
MONGO_URI=your_mongodb_uri

# JWT secret key (use a long, random string in production)
JWT_SECRET=your_jwt_secret_key_here

# JWT token expiry  (e.g. 7d, 30d, 1h)
JWT_EXPIRES_IN=your_jwt_expiry_time

# Server port
PORT=your_port

# Runtime environment: development | production | test
NODE_ENV=your_runtime_environment

# Cloudinary — image storage (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Email / SMTP ──────────────────────────────────────────────────────────────
# CivicFix sends status-change emails via nodemailer.
# For development, use a free Ethereal test account:
#   1. Visit https://ethereal.email/create
#   2. Copy the generated SMTP credentials below
#   3. After each send, the server logs a preview URL — click it to see the email
#
# Switching to a real provider later is a pure env-var change (no code change):
#   Gmail app password → SMTP_HOST=smtp.gmail.com  SMTP_PORT=587
#   SendGrid           → SMTP_HOST=smtp.sendgrid.net  SMTP_USER=apikey  SMTP_PASS=<API key>
#   Mailgun            → SMTP_HOST=smtp.mailgun.org  SMTP_PORT=587
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_ethereal_or_smtp_username
SMTP_PASS=your_ethereal_or_smtp_password
# SMTP_FROM is the "From" address on outbound emails.
# Defaults to SMTP_USER if left blank.
SMTP_FROM=CivicFix <no-reply@civicfix.local>

# ── Frontend URL ──────────────────────────────────────────────────────────────
# Used to build password-reset links in outbound emails.
# In development this is the Vite dev server; change to your production domain.
CLIENT_URL=http://localhost:5173
