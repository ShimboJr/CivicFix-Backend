#  CivicFix — Environment Variables Template

# MongoDB connection string (Atlas or local)
MONGO_URI=your_mongodb_uri

# JWT secret key (use a long, random string in production)
JWT_SECRET=your_jwt_secret_key_here

# JWT token expiry  (e.g. 7d, 30d, 1h)
JWT_EXPIRES_IN=your_jwt_expiry_time

# Server port
PORT=your_port

# Runtime environment: development | production | test
NODE_ENV=your_runtime_environment

# Cloudinary — image storage (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Email / SMTP ──────────────────────────────────────────────────────────────
# CivicFix sends status-change emails via nodemailer
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_ethereal_or_smtp_username
SMTP_PASS=your_ethereal_or_smtp_password
# SMTP_FROM is the "From" address on outbound emails.
# Defaults to SMTP_USER if left blank.
SMTP_FROM=CivicFix <no-reply@civicfix.local>

# ── Frontend URL ──────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Web Push / VAPID ──────────────────────────────────────────────────────────
# Required for push notifications to admin users on new emergency reports.
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@civicfix.example.com
