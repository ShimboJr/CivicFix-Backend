{
  "name": "civicfix-server",
  "version": "1.0.0",
  "description": "CivicFix backend API — community issue reporting platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "lint": "eslint .",
    "test": "cross-env NODE_ENV=test jest --runInBand --forceExit"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testTimeout": 30000
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "multer": "^2.3.0",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^9.0.6",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "jest": "^30.5.0",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2"
